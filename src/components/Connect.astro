---
import Button from "./Button.astro"
---

<article>
    <hr class="bold">
    <div class="connect">
        <div class="insta">
            <h2>FOLLOW US</h2>
            <hr>
            <div class="feed">
                <a href=""><img src="/images/box.png" alt=""></a>
                <a href=""><img src="/images/box.png" alt=""></a>
                <a href=""><img src="/images/box.png" alt=""></a>
                <a href=""><img src="/images/box.png" alt=""></a>
                <a href=""><img src="/images/box.png" alt=""></a>
                <a href=""><img src="/images/box.png" alt=""></a>
        </div>
        </div>
        <img src="" alt="|" style="width:1px; height:100%; background: var(--brown);" class="line1"/>
        <div class="news">
            <hr class="line">
            <h2>SHOPTALK</h2>
            <hr>
            <div class="info">
                <div class="text">
            <p>Wan’t more literature and culture in your inbox? <br>Sign up to receive our monthly newsletter. </p>
            <form>
                <div>
        <label for="name"><p class="bold">NAME</p></label>
        <input type="text" id="name" name="name">
        </div>
        <div>
        <label for="email"><p class="bold">EMAIL</p></label>
        <input type="text" id="email" name="email">
        </div>
        </form>
        </div>
        <a href="/"><Button variant="b1" ><slot name="button">SIGN UP</slot></Button></a>
            </div>
        </div>
    </div>
</article>

<style>
    article{
    padding-bottom: 80px;
    }

    .connect{
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        column-gap: 40px;
		overflow: hidden;
    }

    h2{
        padding-bottom: 20px;
    }

    .info{
        display: flex;
        flex-direction: column;
        gap: 40px;
        padding-top: 40px;
    }

    .text{
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    form{
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    input{
        border-radius: 0;
        height: 64px;
        width: auto;
        border: 1px solid var(--brown);
        background-color: var(--white);
        width:80%;
        box-sizing:border-box;
    }

    input[type="text"]
{
    font-size:18px;
}

    p.bold{
        padding-bottom: 10px;
    }

    .feed{
        padding-top: 40px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
    }

    hr.bold{
        padding-bottom: 20px;
    }

    .line{
        display: none;
    }

    @media (max-width: 800px) {
    article{
    padding-bottom: 40px;
}
.line1{
    display: none;
}
.connect{
        display: flex;
        flex-direction: column;
        gap: 40px;
    }
.feed{
        padding-top: 20px;
    }
    
    h2{
        padding-bottom: 10px;
    }

    .info{
        gap: 20px;
        padding-top: 20px;
    }
    hr.bold{
        padding-bottom: 10px;
    }
    .line{
        display: block;
        padding-top: 10px;
        border-top: 5px solid var(--brown);
    }
}
    @media (max-width: 1000px) {
        
    input{
        height: 42px;
        width:100%;
    }
    }
</style>

