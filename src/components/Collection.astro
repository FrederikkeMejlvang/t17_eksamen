---
import Section_header from "../components/Section_header.astro";
import Card from "./Card.astro";
const data = await fetch("https://awvcgdvcnaczmcuxiuia.supabase.co/rest/v1/books", {
  method: "GET",
  headers: {
    apikey: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF3dmNnZHZjbmFjem1jdXhpdWlhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjI5Mzg3OTAsImV4cCI6MjA3ODUxNDc5MH0.MoWw2g-t4EKxD9j8aywOr7Lm5e3ZlEFJExZ0NTXUXSQ"
  }
}).then(res => res.json());
const book1 = Array.isArray(data) ? data.find(book => book.id === 1) : null;
const book2 = Array.isArray(data) ? data.find(book => book.id === 2) : null;
const book3 = Array.isArray(data) ? data.find(book => book.id === 3) : null;
const book4 = Array.isArray(data) ? data.find(book => book.id === 4) : null;
const book5 = Array.isArray(data) ? data.find(book => book.id === 5) : null;
---

<article>
    <Section_header><span slot="title">NEW RELEASES</span>
  <span slot="button">VIEW ALL</span></Section_header>
  <div class="books">
  <div class="one">{book1 && <Card data={book1} />}</div>
  <div class="two"><img src="" alt="|" style="width:1px; height:100%; background: var(--brown);" class="line1"/></div>
  <div class="three">{book2 && <Card data={book2} />}</div>
  <div class="four"><img src="" alt="|" style="width:1px; height:100%; background: var(--brown);" class="line2"/></div>
  <div class="five">{book3 && <Card data={book3} />}</div>
  <div class="six"><img src="" alt="|" style="width:1px; height:100%; background: var(--brown);"class="line3" /></div>
  <div class="seven">{book4 && <Card data={book4} />}</div>
  <div class="eight"><img src="" alt="|" style="width:1px; height:100%; background: var(--brown);" class="line4"/></div>
  <div class="nine">{book5 && <Card data={book5}/>}</div>
  
  </div>
</article>

<style>
    div.books{
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
        column-gap: 40px;
		  overflow: hidden;
    }

article{
    padding-bottom: 80px;
}
@media (max-width: 800px) {
     div.books{
        grid-template-columns: 1fr auto 1fr;
        column-gap: 20px;
        row-gap: 20px;
     }
    .four, .eight, .nine {
      display: none;
    }
    article{
    padding-bottom: 40px;
}
.line1::before{
  display: none;
}
.line3::before{
  display: none;
}
}

@media (min-width: 800px) and (max-width: 1000px) {
  
    div.books{
        column-gap: 20px;
    }
}

</style>