---
const {newRelease} = Astro.props;
const {data} = Astro.props;
---

<a href={`books/${data.slug}`}>
<article class="book">
    <img src={`/images/${data.image}`} alt={data.name}/>
    <div class="info">
    <p class="small">{data.author}</p>
    <p class="bold">{data.name}</p>
    {newRelease && <p>NEW RELEASE</p>}
    <p class="small">DKK {data.price},-</p>
    </div>
</article>
</a>

<style>
    .bold{
        padding-top: 8px;
        padding-bottom: 8px;
    }
    .info{
        padding-top: 12px;
    }
</style>