---
const {data} = Astro.props;
---

<a href={`/books/${data.slug}`}>
<article class="book">
    <img src={`/images/${data.image}`} alt={data.name}/>
    <div class="info">
    <p class="small">{data.author}</p>
    <p class="bold">{data.name}</p>
    <p class="small">DKK {data.price},-</p>
    </div>
</article>
</a>

<style>
    .bold{
        padding-top: 8px;
        padding-bottom: 8px;
    }
    .info{
        padding-top: 12px;
    }

    .book:hover{
        color: var(--green);
        text-decoration: underline;
    }

    @media (max-width: 800px) {
     .bold{
        padding-top: 6px;
        padding-bottom: 6px;
    }
    .info{
        padding-top: 10px;
    }
    
}
</style>