---
const currentPath = Astro.url.pathname;
---
<nav class="nav-bar">
    <a href="/" class="logo">BOOKS & COMPANY</a>
    <ul class="nav-menu">
        <li class="nav-item">
            <a href="/listview" class={`nav-link ${currentPath === '/listview' ? 'active' : ''}`}>BOOKS</a>
        </li>
        <li class="nav-item">
            <a href="#" class={`nav-link ${currentPath === '/merch' ? 'active' : ''}`}>MERCH</a>
        </li>
        <li class="nav-item">
            <a href="#" class={`nav-link ${currentPath === '/community' ? 'active' : ''}`}>COMMUNITY<i class="fa-solid fa-angle-down" style="font-size:18px;"></i></a>
        </li>
        <li class="nav-item">
            <a href="#" class={`nav-link ${currentPath === '/shoptalk' ? 'active' : ''}`}>SHOPTALK</a>
        </li>
        <li class="nav-item">
            <a href="#" class={`nav-link ${currentPath === '/aboutus' ? 'active' : ''}`}>ABOUT US</a>
        </li>
    </ul>
    <div class="hamburger">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
    </div>
</nav>


<style>
    *{
        box-sizing: border-box;
    }

    li{
        list-style: none;
    }
    .nav-link{
        color: var(--brown);
        font-family: "Montserrat";
        font-size: 18px;
        font-weight: 600;
    }

    .logo{
        display: none;
    color: var(--brown);
    font-family: "Libre Baskerville";
    font-weight: 600;
    font-size: 18px;
    }

    nav{
        padding: 20px 0px;
        transition:padding 0.7s ease;
    }

    .nav-menu{
        display: flex;
        justify-content: space-between;
    }

    .nav-link:hover{
        color: var(--green);
        text-decoration: underline;
    }

.active {
  color: var(--green);

}

    .hamburger{
        display: none;
        cursor: pointer;
        align-self: center;
    }

    .bar{
        display: block;
        width: 21px;
        height: 3px;
        border-radius: 10px;
        margin: 3px auto;
        -webkit-transition: all 0.3s ease-in-out;
        transition: all 0.3s ease-in-out;
        background-color: var(--brown);
    }

    @media(max-width:800px){

        .hamburger{
            display: block;
        }
        .hamburger.active .bar:nth-child(2){
            opacity: 0;
        }
        .hamburger.active .bar:nth-child(1){
            transform: translateY(6px) rotate(45deg);
        }
        .hamburger.active .bar:nth-child(3){
            transform: translateY(-6px) rotate(-45deg);
        }

        .nav-menu{
            position: fixed;
            top: 0; 
            left: -100%;
            gap: 0;
            flex-direction: column;
            background-color: var(--brown);
            width: 100%;
            transition: 0.3s;
            padding: 60px 40px 40px 40px;
        }

        .nav-bar{
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            padding-top: 40px;
        }

        .logo{
            display: block;
            justify-self: center;
            padding-left: 21px;
        }

        .nav-item{
            padding: 20px 0px;
            border-bottom: 1px solid var(--white);
        }

         .nav-item:last-child{
            border-bottom: 0px;
         }

        .nav-menu.active{
            left: 0;
        }
        .bar.active{
        background-color: var(--white);
    }

    .nav-link{
        color: var(--white);
    }
    }

    @media(max-width:1000px){
        .nav-link{
        font-size: 16px;
    }
    }

</style>

<script>

    const hamburger = document.querySelector(".hamburger");
    const navMenu = document.querySelector(".nav-menu");
    const bar1 = document.querySelector(".bar:nth-child(1)");
    const bar3 = document.querySelector(".bar:nth-child(3)");
    
    hamburger?.addEventListener("click", () => {
    hamburger?.classList.toggle("active");
    navMenu?.classList.toggle("active");
    bar1?.classList.toggle("active");
    bar3?.classList.toggle("active");
    })
</script>