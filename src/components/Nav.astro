<style>
    *{
        box-sizing: border-box;
    }

    li{
        list-style: none;
    }
    .nav-link{
        color: var(--brown);
        font-family: "Montserrat";
        font-size: 20px;
        font-weight: 600;
    }

    .logo{
        display: none;
    color: var(--brown);
    font-family: "Libre Baskerville";
    font-weight: 600;
    font-size: 20px;
    }

    nav{
        padding: 20px 0px;
    }

    .nav-menu{
        display: flex;
        justify-content: space-between;
    }

    .nav-link:hover{
        color: var(--green);
        text-decoration: underline;
    }

    .hamburger{
        display: none;
        cursor: pointer;
        align-self: center;
    }

    .bar{
        display: block;
        width: 18px;
        height: 2px;
        border-radius: 10px;
        margin: 3px auto;
        -webkit-transition: all 0.3s ease-in-out;
        transition: all 0.3s ease-in-out;
        background-color: var(--brown);
    }

    @media(max-width:800px){

        .hamburger{
            display: block;
        }
        .hamburger.active .bar:nth-child(2){
            opacity: 0;
        }
        .hamburger.active .bar:nth-child(1){
            transform: translateY(5px) rotate(45deg);
        }
        .hamburger.active .bar:nth-child(3){
            transform: translateY(-5px) rotate(-45deg);
        }

        .nav-menu{
            position: fixed;
            left: -100%;
            gap: 0;
            flex-direction: column;
            background-color: var(--brown);
            width: 100%;
            transition: 0.3s;
            padding: 60px 40px 40px 40px;
            margin-top: -40px;
        }

        .logo{
            display: block;
        }

