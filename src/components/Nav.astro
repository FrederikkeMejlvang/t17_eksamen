            justify-content: space-between;
        }

        .nav-item{
            padding: 20px 20px;
            border-bottom: 1px solid var(--white);
        }

         .nav-item:last-child{
            border-bottom: 0px;
         }

        .nav-menu.active{
            left: 0;
        }
        .bar.active{
        background-color: var(--white);
    }

    .nav-link{
