---
import Button from "./Button.astro"
import Nav from "./Nav.astro"
---

<header>
<div class="navbar">
    <ul class="top">
    <li class="logo"><h2><a href="/" >BOOKS & COMPANY</a></h2></li>
    <li class="search"><a href="/" ><Button variant="b3" ><slot name="button"></slot>SEARCH<i class="fa-solid fa-magnifying-glass"></i></i></Button></a></li>
    </ul>
    <hr class="top-bar">
<Nav></Nav>
    <hr>
</div>
</header>

<style>

    header{
        position: sticky;
        top: 0;
        background-color: var(--white);
        padding-top: 40px;
        padding-left: 80px;
        padding-right: 80px;
    }
    ul{
        padding-left: 0px;
        padding-right: 0px;
    }

    .logo{
        justify-self: center;
        padding-left: 86px;
    }
    .search{
        justify-self: end;
    }
    .top{
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding-bottom: 40px;
    }

    @media(max-width:800px){
        header{
        padding-top: 0px;
        padding-left: 20px;
        padding-right: 20px;
    }
        .top{
        padding-bottom: 20px;
        display: none;
    }
    .top-bar{
        display: none;
    }
    }

    @media (min-width: 800px) and (max-width: 1000px) {
        header{
        padding-left: 40px;
        padding-right: 40px;
    }
    }

</style>