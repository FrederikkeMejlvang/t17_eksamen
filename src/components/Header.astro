---
import Button from "./Button.astro"
import Nav from "./Nav.astro"
---

<header>
<div class="navbar">
    <ul class="top">
    <li class="logo"><h2><a href="/" >BOOKS & COMPANY</a></h2></li>
    <li class="search"><a href="/" ><Button variant="b3" ><slot name="button"></slot>SEARCH</Button></a></li>
    </ul>
    <hr class="top-bar">
<Nav></Nav>
    <hr>
</div>
</header>

<style>

    header{
        position: sticky;
  top: 0;
  background-color: var(--white);
    }
    ul{
        padding-left: 0px;
        padding-right: 0px;
    }

    .logo{
        justify-self: center;
    }
    .search{
        justify-self: end;
    }
    .top{
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding-bottom: 40px;
    }

    @media(max-width:800px){
        .top{
    padding-bottom: 20px;
    display: none;
    }
    .top-bar{
        display: none;
    }
    }

</style>