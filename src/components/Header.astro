---
import Button from "./Button.astro"
---

<nav>
    <ul class="top">
    <li class="logo"><h2><a href="/" >BOOKS & COMPANY</a></li></h2>
    <li class="search"><a href="/" ><Button variant="b3" ><slot name="button"></slot>SEARCH</Button></a></li>
    </ul>
    <hr>
    <ul class="nav">
    <li><a href="listview"><Button variant="b3" ><slot name="button"></slot>BOOKS</Button></a></li>
    <li><a href="/#"><Button variant="b3" ><slot name="button"></slot>MERCH</Button></a></li>
    <li><a href="/#"><Button variant="b3" ><slot name="button"></slot>COMMUNITY</Button></a></li>
    <li><a href="/#"><Button variant="b3" ><slot name="button"></slot>SHOPTALK</Button></a></li>
    <li><a href="/#"><Button variant="b3" ><slot name="button"></slot>ABOUT US</Button></a></li>
    </ul>
    <hr>
</nav>

<style>

    ul{
        padding-left: 0px;
        padding-right: 0px;
    }
    ul.nav{
        padding-top: 20px;
        padding-bottom: 20px;
    }

    .logo{
        justify-self: center;
    }
    .search{
        justify-self: end;
    }
    .top{
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding-bottom: 40px;
    }

    @media (max-width: 800px) {
     ul.nav{
        padding-top: 10px;
        padding-bottom: 10px;
    }
    .top{
    padding-bottom: 20px;
    }
}
</style>