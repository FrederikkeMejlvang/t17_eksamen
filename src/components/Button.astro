---
const {variant} =Astro.props;
---

<button class={variant}>
    <slot></slot>
</button>

<style>
    button{
        border: none;
        outline:none;
        padding: 0px;
        font-family: "Montserrat";
        font-weight: 600;
        cursor: pointer;
    }
    .primary{
        color: var(--brown);
    }
    .secondary{
        color: var(--green);
        font-size: var(--font-size-p-bold);
        background-color: var(--white);
    }
    .secondary:hover{
        text-decoration: underline;
    }
</style>