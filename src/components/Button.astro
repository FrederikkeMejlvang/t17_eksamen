---
const {variant} =Astro.props;
---

<button class={variant}>
    <slot></slot>
</button>

<style>
    button{
        border: none;
        outline:none;
        padding: 0px;
        font-family: "Montserrat";
        font-weight: 600;
        font-size: 20px;
        cursor: pointer;
    }
    .b1{
        color: var(--white);
        background-color: var(--green);
        border: 2px solid var(--green);
        padding: 20px;
    }

    .b1:hover{
        background-color: var(--white);
        color: var(--green);
    }
    .b2{
        color: var(--green);
        background-color: var(--white);
    }

    .b3{
        color: var(--brown);
        background-color: var(--white);
    }
    .b2:hover, .b3:hover{
        text-decoration: underline;
        color: var(--green);
    }

@media (max-width: 800px) {
     button{
        font-size: 12px;
    }
    .b1{
        padding: 10px;
    }
}

@media (min-width: 800px) and (max-width: 1000px) {
  
    button{
        font-size: 16px;
    }

    .b1{
        padding: 10px;
    }
}


</style>